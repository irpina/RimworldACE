<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A façade of exactly the RimWorld and Unity surface the mod uses, read
    out of the last real build's reference tables (docs/87).  Never
    shipped and never referenced by Economy.csproj: it exists so the
    game-facing code can be compiled where RimWorld's managed assemblies
    are not available.  Same target framework as the mod, so the compile
    is the same compile.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SocialProduction.Economy.Facade</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <NoWarn>CS0649;CS0169;CS0067</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
